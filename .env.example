# Entregas-run - Variáveis de Ambiente de Exemplo
# Nunca commite arquivos .env reais ou credenciais com valores no Git.

# Chave de API da TypeSafe para o roteador System One (Jev)
TYPESAFE_API_KEY=sua_chave_typesafe_aqui

# --- Ponte gRPC local do Jev (opcional; ver scripts/jev-bridge.cjs) ---
# Nada aqui e obrigatorio: sem estas variaveis o hook usa auto (gRPC local com
# fallback para HTTPS). A ponte sobe com: npm run jev:bridge
# JEV_TRANSPORT=auto            # auto | grpc | rest
# JEV_GRPC_ADDRESS=127.0.0.1:50051
# JEV_GRPC_PORT=50051
# JEV_GRPC_TIMEOUT_MS=3000      # deadline da chamada gRPC
# JEV_GRPC_PROBE_MS=400         # deadline da sondagem Health no modo auto
# JEV_GRPC_REQUIRED=0           # 1 = falha se a ponte estiver fora do ar
# JEV_MODEL=jev-latest
# JEV_API_BASE_URL=https://api.typesafe.ai
# JEV_REST_TIMEOUT_MS=6000
# JEV_CACHE_TTL_MS=1800000      # 30 min
# JEV_STATE_DIR=./scratch
# JEV_METRICS_DIR=./.metrics
# JEV_MAX_STATE_CHARS=20000
# JEV_DEBUG=0                   # 1 = diagnostico no stderr do hook
# JEV_HOOK_BYPASS_CACHE=0       # 1 = ignora o cache do hook (forca nova classificacao)
# JEV_SKIP_DOTENV=0             # 1 = ignora o .env (testes)
